# Public-safe values only. Never put provider keys, JWT secrets or database URLs here.

# Backend origin. Leave empty in development: the Vite dev server proxies /api, /health and /ready
# to VITE_DEV_PROXY_TARGET. For a deployed frontend set the full backend origin, e.g. https://api.example.com
VITE_API_URL=

# Where the dev proxy forwards API calls (development only).
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# Dev server port.
VITE_PORT=5173

# Show the Diagnostics page (always off in production builds unless explicitly true).
VITE_ENABLE_DIAGNOSTICS=
