# Copy to .env and fill in. Never commit .env. All settings: app/core/config.py

APP_NAME=Legal Lens
APP_ENV=development            # development | test | staging | production
LOG_LEVEL=INFO
LOG_JSON=true

# ---- HTTP / security ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
PUBLIC_BASE_URL=http://127.0.0.1:8000
FRONTEND_DIST_PATH=            # optional: serve a built frontend (e.g. ./frontend/dist) from this process
MAX_REQUEST_BYTES=65536
MAX_QUERY_CHARS=4000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# ---- auth ----
AUTH_REQUIRED=false            # true: chat/search/statute endpoints need a bearer token
AUTH_ALLOW_REGISTRATION=true
JWT_SECRET_KEY=                # required in production (>= 32 chars): python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- database (users) — SQLite by default; PostgreSQL: postgresql+asyncpg://user:pass@host/db ----
DATABASE_URL=sqlite+aiosqlite:///./data/legal_lens.db
DB_AUTO_MIGRATE=true

# ---- vector store: set QDRANT_URL for Qdrant Cloud/server, or QDRANT_PATH for embedded mode ----
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=legal-lens-chunks
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_SPARSE_VECTOR_NAME=sparse
QDRANT_CREATE_COLLECTION=true

# ---- embeddings ----
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu
EMBEDDING_VERSION=1
EMBEDDING_PRELOAD=true

# ---- reranker ----
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_FALLBACK_TO_LEXICAL=true

# ---- LLM (GROQ_API_KEY is accepted as an alias of LLM_API_KEY) ----
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
LLM_TIMEOUT=30
LLM_RETRY_ENABLED=true
LLM_MAX_RETRIES=2
LLM_BACKOFF=0.5
LLM_PROVIDER_ORDER=            # e.g. groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b (retry/fallback chain)
LLM_REASONING_MODEL_PREFIXES=openai/gpt-oss,qwen/qwen3
LLM_REASONING_EFFORT=low

# ---- knowledge graph (enabled automatically when NEO4J_URI is set) ----
NEO4J_ENABLED=
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# ---- routing / retrieval ----
COMPLEXITY_ROUTING_ENABLED=true
QUERY_DECOMPOSITION_ENABLED=true
DECOMPOSITION_USE_LLM=true
DECOMPOSITION_MAX_SUBQUERIES=5
MAX_CONTEXT_TOKENS=6000
DEFAULT_TOP_K=8
EVIDENCE_MIN_TERM_COVERAGE=0.34
EVIDENCE_MIN_DENSE_SCORE=0.6
OUTPUT_VALIDATION_MAX_REGENERATIONS=1
PIPELINE_TIMEOUT=90

# ---- chunking / adaptive selection ----
CHUNKING_DEFAULT_PROFILE=hierarchical-400
ADAPTIVE_SELECTION_MODE=rules  # rules | data_driven (uses evaluation/results/latest.json)

# ---- MEM-0 session memory (process-local, non-persistent) ----
SESSION_MEMORY_ENABLED=true
SESSION_MEMORY_MAX_TURNS=4
SESSION_MEMORY_TTL_SECONDS=1800
